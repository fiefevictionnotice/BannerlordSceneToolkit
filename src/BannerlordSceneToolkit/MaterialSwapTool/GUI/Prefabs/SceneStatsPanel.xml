<Prefab>
  <Window>
    <Widget Id="PanelRoot" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="780" SuggestedHeight="1000" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Children>
        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="StdAssets\Popup\canvas" IsEnabled="false" />
        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="StdAssets\Popup\canvas_gradient" IsEnabled="false" />
        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="frame_9" ExtendLeft="18" ExtendTop="18" ExtendRight="18" ExtendBottom="18" IsEnabled="false" />

        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" StackLayout.LayoutMethod="VerticalTopToBottom" MarginLeft="20" MarginRight="20" MarginTop="16" MarginBottom="16" DoNotAcceptEvents="true">
          <Children>

            <!-- Drag handle: press-and-hold the title row to move the whole panel. -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="34" MarginBottom="6" Command.MouseDown="ExecuteDragStart">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="Scene Statistics" Brush="Popup.Title.Text" HorizontalAlignment="Center" VerticalAlignment="Center" DoNotAcceptEvents="true" />
              </Children>
            </Widget>

            <!-- Scene totals: five lines, six once the Heaviest tab has counted triangles.
                 Fixed height sized for six so the tables below never jump. -->
            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="150" Text="@TotalsText" Brush="Popup.Description.Text" Brush.TextHorizontalAlignment="Left" Brush.TextVerticalAlignment="Top" CanBreakWords="true" HorizontalAlignment="Left" MarginBottom="8" DoNotAcceptEvents="true" />

            <!-- Tabs. The active one is green; the sort toggle only exists on the Lights tab.
                 170+170+130 + 190 = 660 of 740. -->
            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="34" StackLayout.LayoutMethod="HorizontalLeftToRight" MarginBottom="6">
              <Children>
                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="170" Brush="Popup.Done.Button.NineGrid" Color="@PrefabsTabColor" Command.Click="ExecuteShowPrefabs" MarginRight="4">
                  <Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="Most-Used Prefabs" Brush="Popup.Button.Text" HorizontalAlignment="Center" VerticalAlignment="Center" DoNotAcceptEvents="true" /><TextWidget Id="Hint" IsVisible="false" DoNotAcceptEvents="true" Text="Shows the distinct prefabs ordered by how many instances the scene has. Uses the last scan; press Refresh after editing the scene." /></Children>
                </ButtonWidget>
                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="170" Brush="Popup.Done.Button.NineGrid" Color="@MeshesTabColor" Command.Click="ExecuteShowMeshes" MarginRight="4">
                  <Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="Heaviest Meshes" Brush="Popup.Button.Text" HorizontalAlignment="Center" VerticalAlignment="Center" DoNotAcceptEvents="true" /><TextWidget Id="Hint" IsVisible="false" DoNotAcceptEvents="true" Text="Shows the distinct meshes ordered by LOD0 triangles times instances. The triangle count runs the first time this tab is opened after a scan, so it can take a moment." /></Children>
                </ButtonWidget>
                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="130" Brush="Popup.Done.Button.NineGrid" Color="@LightsTabColor" Command.Click="ExecuteShowLights" MarginRight="20">
                  <Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="Lights" Brush="Popup.Button.Text" HorizontalAlignment="Center" VerticalAlignment="Center" DoNotAcceptEvents="true" /><TextWidget Id="Hint" IsVisible="false" DoNotAcceptEvents="true" Text="Lists every light with radius, shadow, intensity and color; flagged lights are marked [!] and tinted. Uses the last scan; press Refresh after editing the scene." /></Children>
                </ButtonWidget>
                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="190" Brush="Popup.Cancel.Button.NineGrid" Color="#8a5fc9FF" Command.Click="ExecuteToggleSort" IsVisible="@IsLightsTab">
                  <Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="@SortButtonText" Brush="Popup.Button.Text" HorizontalAlignment="Center" VerticalAlignment="Center" DoNotAcceptEvents="true" /><TextWidget Id="Hint" IsVisible="false" DoNotAcceptEvents="true" Text="Switches the light list to the order named on this button: by radius, or by shadow cost (shadow-casting first, then largest radius). Reorders the last scan only." /></Children>
                </ButtonWidget>
              </Children>
            </ListPanel>

            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="40" Text="@HeaderText" Brush="Popup.Description.Text" Brush.TextHorizontalAlignment="Left" CanBreakWords="true" HorizontalAlignment="Left" MarginBottom="6" DoNotAcceptEvents="true" />

            <!-- The table. One shared list for all three tabs; rows are paged (Show More)
                 because Gauntlet builds real widgets for every row. -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginBottom="10">
              <Children>
                <ScrollablePanel Id="StatsScrollablePanel" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginRight="14" AutoHideScrollBars="true" ClipRect="StatsClipRect" InnerPanel="StatsClipRect\StatsListPanel" VerticalScrollbar="..\StatsScrollbar">
                  <Children>
                    <Widget Id="StatsClipRect" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                      <Children>
                        <ListPanel Id="StatsListPanel" DataSource="{Rows}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom" ClipContents="true">
                          <ItemTemplate>
                            <!-- Background tint marks a flagged light. Buttons hide themselves
                                 per row (IsVisible on the button, as in the results window), so
                                 a Lights row has Go only and its text takes the freed width. -->
                            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Sprite="BlankWhiteSquare_9" Color="@RowColor" MarginBottom="3">
                              <Children>
                                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="HorizontalLeftToRight" MarginLeft="6" MarginRight="6" MarginTop="2" MarginBottom="2">
                                  <Children>
                                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="76" SuggestedHeight="28" Brush="Popup.Done.Button.NineGrid" Color="#3ba1c9FF" MarginRight="4" MarginTop="3" IsVisible="@HasSelect" Command.Click="ExecuteSelect">
                                      <Children>
                                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="Select" Brush="Popup.Button.Text" Brush.FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" DoNotAcceptEvents="true" />
                                        <TextWidget Id="Hint" IsVisible="false" DoNotAcceptEvents="true" Text="Replaces the editor selection with every instance of this prefab, or every entity using this mesh, found in the live scene right now. Changes nothing in the scene; the selection lands a moment after the click." />
                                      </Children>
                                    </ButtonWidget>
                                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="54" SuggestedHeight="28" Brush="Popup.Done.Button.NineGrid" Color="#3ba1c9FF" MarginRight="8" MarginTop="3" IsVisible="@HasGo" Command.Click="ExecuteGo">
                                      <Children>
                                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="Go" Brush="Popup.Button.Text" Brush.FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" DoNotAcceptEvents="true" />
                                        <TextWidget Id="Hint" IsVisible="false" DoNotAcceptEvents="true" Text="Moves the editor camera to this row's position (the first instance, or the light) and selects the entity found exactly there, if any. Changes nothing in the scene." />
                                      </Children>
                                    </ButtonWidget>
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MinHeight="34" Text="@Text" Brush="MaterialSwapTool.DiffLineText" HorizontalAlignment="Left" CanBreakWords="true" DoNotAcceptEvents="true" />
                                  </Children>
                                </ListPanel>
                              </Children>
                            </Widget>
                          </ItemTemplate>
                        </ListPanel>
                      </Children>
                    </Widget>
                  </Children>
                </ScrollablePanel>
                <ScrollbarWidget Id="StatsScrollbar" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="6" HorizontalAlignment="Right" AlignmentAxis="Vertical" Handle="StatsScrollbarHandle" MaxValue="100" MinValue="0">
                  <Children>
                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="4" HorizontalAlignment="Center" Sprite="BlankWhiteSquare_9" Color="#5a4033FF" AlphaFactor="0.2" />
                    <ImageWidget Id="StatsScrollbarHandle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedHeight="10" SuggestedWidth="8" HorizontalAlignment="Center" Brush="FaceGen.Scrollbar.Handle" />
                  </Children>
                </ScrollbarWidget>
              </Children>
            </Widget>

            <!-- 120+170+170+110 = 570 (+ margins) of 740. Show More hides when nothing is left. -->
            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="34" StackLayout.LayoutMethod="HorizontalLeftToRight" MarginBottom="8">
              <Children>
                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="120" Brush="Popup.Done.Button" Command.Click="ExecuteRefresh" MarginRight="4">
                  <Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="Refresh" Brush="Popup.Button.Text" HorizontalAlignment="Center" VerticalAlignment="Center" DoNotAcceptEvents="true" /><TextWidget Id="Hint" IsVisible="false" DoNotAcceptEvents="true" Text="Rescans the live scene, unsaved changes included, and rebuilds the totals and all three tables. Nothing in this window updates until you press this." /></Children>
                </ButtonWidget>
                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="170" Brush="Popup.Cancel.Button.NineGrid" Color="#4fb96aFF" Command.Click="ExecuteWriteReport" MarginRight="4">
                  <Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="Write Report" Brush="Popup.Button.Text" HorizontalAlignment="Center" VerticalAlignment="Center" DoNotAcceptEvents="true" /><TextWidget Id="Hint" IsVisible="false" DoNotAcceptEvents="true" Text="Writes the totals, prefabs and lights of the last scan to a text file in Documents\Mount and Blade II Bannerlord\MaterialSwapTool\Reports. Meshes are included only if the Heaviest Meshes tab was opened since that scan." /></Children>
                </ButtonWidget>
                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="110" Brush="Popup.Cancel.Button.NineGrid" Color="#c9484eFF" Command.Click="ExecuteClose" MarginRight="20">
                  <Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="Close" Brush="Popup.Button.Text" HorizontalAlignment="Center" VerticalAlignment="Center" DoNotAcceptEvents="true" /></Children>
                </ButtonWidget>
                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="170" Brush="Popup.Done.Button.NineGrid" Color="#3ba1c9FF" Command.Click="ExecuteShowMore" IsVisible="@IsShowMoreVisible">
                  <Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="@ShowMoreText" Brush="Popup.Button.Text" HorizontalAlignment="Center" VerticalAlignment="Center" DoNotAcceptEvents="true" /><TextWidget Id="Hint" IsVisible="false" DoNotAcceptEvents="true" Text="Adds the next 60 rows to the table, up to 600 in total. Uses the last scan; nothing is rescanned." /></Children>
                </ButtonWidget>
              </Children>
            </ListPanel>

            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="44" Text="@StatusText" Brush="Popup.Description.Text" CanBreakWords="true" HorizontalAlignment="Center" DoNotAcceptEvents="true" />

          </Children>
        </ListPanel>
      </Children>
    </Widget>
  </Window>
</Prefab>
